# --- Kapso / WhatsApp Cloud API (requerido) ---
KAPSO_API_KEY=
# Opcional: fallback de un solo número si no usas /settings para seleccionar números
PHONE_NUMBER_ID=
WABA_ID=
# Opcional: endpoint de la API de mensajería (por defecto https://api.kapso.ai/meta/whatsapp)
WHATSAPP_API_URL=
# Opcional: solo si la API de la plataforma Kapso vive en otro host que WHATSAPP_API_URL
KAPSO_API_BASE_URL=

# --- Webhook (src/app/api/webhooks/whatsapp) ---
# Requerido para que el endpoint del webhook valide la firma HMAC de Kapso.
WEBHOOK_SECRET=

# --- Respuesta automática con IA ---
# API key de Groq (console.groq.com) — nivel gratuito, sin tarjeta de crédito.
# El webhook (src/app/api/webhooks/whatsapp) la usa para responder
# automáticamente a cada mensaje de texto entrante.
# Sin esta variable, el auto-reply falla silenciosamente (se registra el error
# en consola pero el webhook igual responde 200 a Kapso).
GROQ_API_KEY=
